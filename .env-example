# Anchor Replay Distillation — all settings in one file.
# Copy to .env, fill in required values, then run:
#   uv sync --extra dev
#   uv run ard generate
#
# ard generate accepts zero CLI arguments. Every knob is below.

# ── Required API: input generator (the model that creates user prompts) ──
ARD_INPUT_GENERATOR_API_BASE=https://example.com/v1
ARD_INPUT_GENERATOR_MODEL_NAME=deepseek-v4-flash
ARD_INPUT_GENERATOR_API_KEY=replace-me

# ── Required API: target model (the model being trained; its answers become SFT labels) ──
ARD_TARGET_API_BASE=https://example.com/v1
ARD_TARGET_MODEL_NAME=deepseek-v4-flash
ARD_TARGET_API_KEY=replace-me

# ── Generation ──
ARD_TARGET_COUNT=10
ARD_SEED=42
ARD_EXACT_FINAL_COUNT_ENABLED=false
ARD_EXACT_FINAL_COUNT_BATCH_SIZE=10
ARD_EXACT_FINAL_COUNT_MAX_BATCHES=3

# ── Output ──
# ARD_OUTPUT_DIR: leave blank for a timestamped directory under outputs/
ARD_OUTPUT_DIR=
ARD_OVERWRITE_OUTPUT=false

# ── Ontology ──
ARD_ONTOLOGY_PATH=configs/anchor_ontology.json
ARD_ONTOLOGY_EMBEDDINGS_PATH=configs/anchor_ontology_embeddings.json
ARD_SAMPLING_STRATEGY=farthest
# Optional runtime filters (comma-separated, leave blank to use ontology defaults):
ARD_LANGUAGES=
ARD_TASK_TYPES=

# ── API behaviour ──
# ARD_TEMPERATURE controls input generator creativity (prompt diversity).
ARD_TEMPERATURE=0.7
# ARD_TARGET_TEMPERATURE controls target model decoding (0.0 = greedy for faithful replay).
ARD_TARGET_TEMPERATURE=0.0
ARD_TOP_P=0.95
ARD_TIMEOUT=60
ARD_MAX_RETRIES=2
ARD_INPUT_GENERATOR_CONCURRENCY=100
ARD_TARGET_CONCURRENCY=100

# ── Filtering ──
ARD_MIN_TARGET_ANSWER_CHARS=8
# 0 means no upper limit:
ARD_MAX_TARGET_ANSWER_CHARS=0

# ── System persona (input prompt style diversity) ──
# Comma-separated subset of: none, one_sentence, appropriate, detailed
# Leave blank to include all four in the sampling pool.
ARD_SYSTEM_PERSONAS=

# ── Reasoning control ──
# Set to "none" to disable thinking/reasoning in target model responses.
# Supported by vllm 0.22+, OpenAI, and compatible providers.
# Leave blank to use the model's default behaviour.
ARD_TARGET_REASONING_EFFORT=

# ── Token caps (leave blank / 0 to let the provider decide) ──
ARD_INPUT_GENERATOR_MAX_TOKENS=0
ARD_TARGET_MAX_TOKENS=0
