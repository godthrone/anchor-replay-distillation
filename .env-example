# Anchor Replay Distillation default environment.
# Copy this file to .env, then fill in your API values.
#
# Required OpenAI-compatible API settings for the strong input generator model.
# This model creates realistic user messages from sampled anchor specs.
ARD_INPUT_GENERATOR_API_BASE=https://example.com/v1
ARD_INPUT_GENERATOR_MODEL_NAME=deepseek-v4-flash
ARD_INPUT_GENERATOR_API_KEY=replace-me

# Required OpenAI-compatible API settings for the target model.
# This is the model you are preparing/training/evaluating; its answers become SFT targets.
ARD_TARGET_API_BASE=https://example.com/v1
ARD_TARGET_MODEL_NAME=deepseek-v4-flash
ARD_TARGET_API_KEY=replace-me

# Default data generation settings.
# ARD_TARGET_COUNT is attempted candidates; filtering may leave fewer final rows.
ARD_TARGET_COUNT=10
ARD_EXACT_FINAL_COUNT_ENABLED=false
ARD_EXACT_FINAL_COUNT_BATCH_SIZE=10
ARD_EXACT_FINAL_COUNT_MAX_BATCHES=3
# Default seed is 42. Change it for a different reproducible sample mix.
ARD_SEED=42

# Output path. Relative paths are resolved from the project root.
# Leave ARD_OUTPUT_DIR blank to create a timestamped run directory under outputs/.
# Set ARD_OVERWRITE_OUTPUT=true only when you intentionally want to replace an existing output dir.
ARD_OUTPUT_DIR=
ARD_OVERWRITE_OUTPUT=false

# Sampling ontology. This single JSON contains languages, domains, capabilities,
# conversation types, and language features.
ARD_ONTOLOGY_PATH=configs/anchor_ontology.json
ARD_ONTOLOGY_EMBEDDINGS_PATH=configs/anchor_ontology_embeddings.json
ARD_SAMPLING_STRATEGY=farthest

# Optional runtime filters. Comma-separated values; leave blank to use the ontology defaults.
# Examples:
# ARD_LANGUAGES=English,简体中文,Español,日本語
# ARD_TASK_TYPES=qa,explanation,reasoning,coding,debugging
ARD_LANGUAGES=
ARD_TASK_TYPES=

# Optional API behavior.
ARD_TEMPERATURE=0.7
ARD_TOP_P=0.95
ARD_TIMEOUT=60
ARD_MAX_RETRIES=2
ARD_INPUT_GENERATOR_CONCURRENCY=100
ARD_TARGET_CONCURRENCY=100

# Optional filtering.
# Leave ARD_MAX_TARGET_ANSWER_CHARS blank to keep long target answers.
ARD_MIN_TARGET_ANSWER_CHARS=8
ARD_MAX_TARGET_ANSWER_CHARS=

# Optional token caps.
# Strict default: leave these blank so the provider/model uses its default output budget.
# Only set them when you intentionally want to override that default.
ARD_INPUT_GENERATOR_MAX_TOKENS=
ARD_TARGET_MAX_TOKENS=
