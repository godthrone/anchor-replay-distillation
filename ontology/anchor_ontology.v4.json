{
  "ontology_id": "ard-anchor-ontology",
  "version": "4.0.0",
  "supersedes": "ontology/anchor_ontology.json (v3, removed; this file is now the single ontology)",
  "scope_note": "Coordinates only. No prompt wording, no sampling/weighting/experiment policy.",
  "axis_order": [
    "language",
    "knowledge_domain",
    "capability",
    "system_prompt_mode",
    "conversation_type",
    "response_style",
    "output_format",
    "difficulty",
    "context_length",
    "input_condition",
    "answer_mode",
    "visual_domain"
  ],
  "reading_rules": {
    "axis_value_set": "flat axes use `values`; hierarchical axes use every leaf at the deepest level of the tree named by `tree_ref`; grouped axes use the concatenation of each group's `values`.",
    "wildcard": "In constraint rules, \"*\" means every value of that side's axis.",
    "axis_vs_sample_field": "`modality` is a sample field (text_only | image), not an ontology axis; it only switches the conditional axis on and off."
  },
  "axes": {
    "language": {
      "layer": "content",
      "cardinality": "single",
      "applies_to": "all_samples",
      "values": [
        "English",
        "简体中文",
        "Español",
        "日本語"
      ],
      "semantics": "Language of the assistant's output (answer / target text). Source language is NOT a coordinate; see constraint R6."
    },
    "knowledge_domain": {
      "layer": "content",
      "cardinality": "single",
      "applies_to": "all_samples",
      "value_model": "hierarchical",
      "levels": [
        "domain",
        "subdomain",
        "leaf"
      ],
      "leaf_is_value": true,
      "tree_ref": "knowledge_domain_tree"
    },
    "capability": {
      "layer": "content",
      "cardinality": "single",
      "applies_to": "all_samples",
      "value_model": "grouped",
      "groups": {
        "knowledge_response": {
          "values": [
            "qa",
            "explanation",
            "comparison",
            "critique"
          ]
        },
        "reasoning": {
          "values": [
            "reasoning",
            "math_solving",
            "planning",
            "decision_analysis"
          ]
        },
        "coding_and_data": {
          "values": [
            "coding",
            "debugging",
            "extraction",
            "data_analysis"
          ]
        },
        "language_work": {
          "values": [
            "summarization",
            "rewriting",
            "translation",
            "creative_writing"
          ]
        },
        "agentic_behavior": {
          "values": [
            "tool_use",
            "ask_clarification",
            "uncertainty_handling",
            "structured_response"
          ]
        }
      }
    },
    "system_prompt_mode": {
      "layer": "form",
      "cardinality": "single",
      "applies_to": "all_samples",
      "values": [
        "none",
        "minimal_persona",
        "detailed_persona",
        "task_constraint",
        "domain_style"
      ],
      "value_definitions": {
        "none": "No system prompt is present.",
        "minimal_persona": "A single-clause role identity only; no format, length or domain constraints.",
        "detailed_persona": "Role identity plus background or experience and behavioural tendencies; no format or length constraints.",
        "task_constraint": "Hard output constraints: format, language, length, and must-do / must-not-do rules.",
        "domain_style": "A professional style setting that matches this sample's knowledge domain and capability."
      },
      "note": "Presence and style are one axis: `none` is the absence case of the same coordinate."
    },
    "conversation_type": {
      "layer": "form",
      "cardinality": "single",
      "applies_to": "all_samples",
      "values": [
        "single_turn",
        "clarification",
        "troubleshooting",
        "iterative_revision",
        "constraint_update",
        "tool_assisted",
        "source_review"
      ],
      "value_attributes": {
        "single_turn": {
          "turns": 1
        },
        "clarification": {
          "turns": 2
        },
        "troubleshooting": {
          "turns": 3
        },
        "iterative_revision": {
          "turns": 3
        },
        "constraint_update": {
          "turns": 4
        },
        "tool_assisted": {
          "turns": "multi"
        },
        "source_review": {
          "turns": "multi"
        }
      },
      "note": "Turn count is an attribute, never part of the value name."
    },
    "response_style": {
      "layer": "instruction",
      "cardinality": "single",
      "applies_to": "all_samples",
      "values": [
        "concise",
        "step-by-step",
        "professional",
        "plain language",
        "teaching",
        "formal",
        "casual"
      ]
    },
    "output_format": {
      "layer": "instruction",
      "cardinality": "single",
      "applies_to": "all_samples",
      "values": [
        "paragraph",
        "bullets",
        "table",
        "JSON",
        "code block",
        "markdown report"
      ]
    },
    "difficulty": {
      "layer": "instruction",
      "cardinality": "single",
      "applies_to": "all_samples",
      "values": [
        "basic",
        "intermediate",
        "advanced"
      ]
    },
    "context_length": {
      "layer": "instruction",
      "cardinality": "single",
      "applies_to": "all_samples",
      "values": [
        "short",
        "medium",
        "long_context"
      ]
    },
    "input_condition": {
      "layer": "instruction",
      "cardinality": "single",
      "applies_to": "all_samples",
      "values": [
        "clean",
        "irrelevant_details",
        "missing_info",
        "conflicting_constraints",
        "ambiguous",
        "edge_case"
      ],
      "note": "Degraded-input axis: absorbs `ambiguous` and `edge_case` from the old difficulty axis."
    },
    "answer_mode": {
      "layer": "instruction",
      "cardinality": "single",
      "applies_to": "all_samples",
      "values": [
        "direct_answer",
        "explain_then_answer",
        "ask_before_answering",
        "structured_analysis"
      ]
    },
    "visual_domain": {
      "layer": "modality",
      "cardinality": "single",
      "applies_to": {
        "requires_modality": "image"
      },
      "absent_when": {
        "modality": "text_only"
      },
      "value_model": "grouped",
      "groups": {
        "object_recognition": {
          "definition": "Identifying objects, people and scenes present in an image.",
          "values": [
            "everyday_objects",
            "animals",
            "plants",
            "vehicles",
            "buildings",
            "food",
            "clothing"
          ]
        },
        "spatial_reasoning": {
          "definition": "Understanding spatial relations, position, depth and direction in an image.",
          "values": [
            "relative_position",
            "depth_estimation",
            "occlusion",
            "distance_judgment"
          ]
        },
        "scene_understanding": {
          "definition": "Understanding the overall scene, activity and atmosphere of an image.",
          "values": [
            "indoor_scenes",
            "outdoor_scenes",
            "urban_scenes",
            "natural_landscapes",
            "crowd_scenes"
          ]
        },
        "text_reading": {
          "definition": "Reading text in an image: printed text, handwriting, signs, screenshots, documents.",
          "values": [
            "printed_text",
            "handwriting",
            "signs",
            "screenshots",
            "documents"
          ]
        }
      },
      "note": "Conditional axis: present iff the sample carries an image (see constraint R5)."
    }
  },
