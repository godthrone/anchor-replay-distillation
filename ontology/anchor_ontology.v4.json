  "constraints": [
    {
      "id": "R1",
      "type": "allowed_pairs",
      "from": {
        "axis": "system_prompt_mode"
      },
      "to": {
        "axis": "capability"
      },
      "rules": [
        {
          "from_value": "none",
          "to_values": [
            "*"
          ]
        },
        {
          "from_value": "minimal_persona",
          "to_values": [
            "qa",
            "explanation",
            "ask_clarification"
          ]
        },
        {
          "from_value": "detailed_persona",
          "to_values": [
            "explanation",
            "critique",
            "reasoning",
            "creative_writing",
            "comparison",
            "decision_analysis",
            "uncertainty_handling"
          ]
        },
        {
          "from_value": "task_constraint",
          "to_values": [
            "structured_response",
            "extraction",
            "summarization",
            "comparison",
            "rewriting",
            "translation",
            "tool_use"
          ]
        },
        {
          "from_value": "domain_style",
          "to_values": [
            "coding",
            "debugging",
            "data_analysis",
            "math_solving",
            "planning",
            "decision_analysis",
            "translation"
          ]
        }
      ],
      "coverage": {
        "axis": "capability",
        "require": "all_values_covered_by_non_wildcard_rules"
      },
      "rationale": "Each capability must be reachable by at least one non-`none` system-prompt mode. The 4 legacy mappings covered 13/20; the 7 additions (comparison, decision_analysis, rewriting, translation, tool_use, ask_clarification, uncertainty_handling) complete 20/20. `none` is universal: omitting the system prompt is never capability-specific."
    },
